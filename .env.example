# Copy this file to .env.local and fill in your keys. Never commit .env.local.

# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# https://console.deepgram.com (free starting credit)
DEEPGRAM_API_KEY=

# Long random string that signs the sign-up cookie. Generate one with: openssl rand -base64 32
SESSION_SECRET=

# Kit (optional locally): adds sign-ups to your list tagged "SpeakUp". Same key as the website.
KIT_API_KEY=

# Optional daily caps (defaults shown)
# DAILY_TAKES_PER_PERSON=10
# DAILY_TAKES_PER_IP=20
# DAILY_TAKES_TOTAL=300
